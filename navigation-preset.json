  "calmState": {
    "scrollThresholdPx": 24,
    "directionDeltaPx": 4,
    "prominentHeightPx": {
      "desktop": 76,
      "compact": 68
    },
    "calmVisibleSurfaceHeightPx": {
      "desktop": 29,
      "compact": 27
    },
    "calmSemanticHitboxHeightPx": 44,
    "visualScale": 0.5,
    "contentOpacity": 1,
    "canvasMixPercent": {
      "prominent": 92,
      "calmLight": 80,
      "calmDark": 78
