  "icons": {
    "family": "Material Symbols Rounded",
    "fill": 0,
    "weight": 300,
    "navigationSubset": "assets/fonts/material-symbols-rounded-nav-300-v0.9.1.woff2",
    "pageFont": "assets/fonts/material-symbols-rounded-full-v370.woff2",
    "license": "assets/licenses/material-symbols-Apache-2.0.txt"
  },
  "rejectedCandidateDivergences": [
    "continuous CTA animation",
    "semantic targets scaled below 44px",
    "unapproved reconstructed master-brand symbol",
    "filled selected-state icon glyphs"
