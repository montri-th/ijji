    "transitionMs": 560,
    "returnsToProminentOn": [
      "scroll_up",
      "near_page_top",
      "visible_surface_hover",
      "navigation_focus",
      "menu_open"
    ],
    "reducedMotion": "always_prominent"
  },
  "ctaCue": {
    "type": "sweeping_text_highlight",
    "durationMs": 540,
    "bandPercent": 28,
    "playCount": "once_per_page_load",
    "trigger": "first_visible_CTA_entry",
    "movesButtonGeometry": false,
    "reducedMotion": "hidden"
  },
  "bookmarkRail": {
    "minViewportWidthPx": 1280,
    "position": "fixed_right_center",
    "targets": [
      { "marker": "01", "id": "top", "label": "ภาพรวม" },
      { "marker": "02", "id": "why", "label": "ทำไมต้องมีอิจจี้" },
      { "marker": "03", "id": "locale", "label": "รอบย่าน" },
      { "marker": "04", "id": "answer", "label": "ตัวอย่างคำตอบ" },
      { "marker": "05", "id": "problems", "label": "ปัญหาร้าน 12 แบบ" }
    ],
    "targetSizePx": 44,
    "labelMode": "visible_tooltip_on_hover_or_focus",
    "currentState": [
      "aria-current_location",
      "accent_ink",
      "tinted_surface",
      "inset_outline"
    ],
    "compactFallback": "same_targets_in_disclosure_menu"
  },
  "menu": {
    "semantics": "ordinary_link_disclosure",
    "opensFocusOn": "first_visible_link",
    "closesOn": [
      "Escape",
      "backdrop_click",
      "trigger_toggle",
      "section_selection",
      "focus_leave"
    ],
    "noJavaScriptFallback": "expanded_inline_navigation"
