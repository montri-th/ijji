{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "addons/ijji/motif/**",
              "components/actions/**",
              "components/data/**",
              "components/evidence/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/identity/**",
              "components/surfaces/**",
              "ui_kits/identity-playground/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Arvo|IBM Plex Sans Thai Looped|Bai Jamjuree|JetBrains Mono|IBM Plex Sans Thai|Cambria|Noto Sans Thai|Noto Sans Thai Looped|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Arvo, IBM Plex Sans Thai Looped, Bai Jamjuree, JetBrains Mono, IBM Plex Sans Thai, Cambria, Noto Sans Thai, Noto Sans Thai Looped, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtmosphereSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:atmosphere|as|pad|radius|children|key|ref|className|style|children)$/]",
        "message": "<AtmosphereSurface> doesn't accept that prop. Declared props: atmosphere, as, pad, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandSignature'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|src|width|surface|alt|decorative|key|ref|className|style|children)$/]",
        "message": "<BrandSignature> doesn't accept that prop. Declared props: variant, src, width, surface, alt, decorative."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconOnly|icon|busy|busyLabel|disabled|pendingReason|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconOnly, icon, busy, busyLabel, disabled, pendingReason, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|numeric|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, numeric."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:object|status|statusLabel|metric|unit|meaning|source|limitation|nextAction|baseline|children|key|ref|className|style|children)$/]",
        "message": "<DecisionCard> doesn't accept that prop. Declared props: object, status, statusLabel, metric, unit, meaning, source, limitation, nextAction, baseline, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|note|onClose|footer|children|labelledBy|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, note, onClose, footer, children, labelledBy."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|reason|stillPossible|children|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: label, title, reason, stillPossible, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|detail|preserved|children|key|ref|className|style|children)$/]",
        "message": "<ErrorState> doesn't accept that prop. Declared props: label, title, detail, preserved, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|help|error|required|as|options|value|defaultValue|placeholder|onChange|children|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: id, label, help, error, required, as, options, value, defaultValue, placeholder, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|weight|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, weight."
      },
      {
        "selector": "JSXOpeningElement[name.name='IjjiMotif'] > JSXAttribute > JSXIdentifier[name!=/^(?:motif|surface|size|animated|speed|label|key|ref|className|style|children)$/]",
        "message": "<IjjiMotif> doesn't accept that prop. Declared props: motif, surface, size, animated, speed, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|external|onDeep|children|key|ref|className|style|children)$/]",
        "message": "<Link> doesn't accept that prop. Declared props: href, external, onDeep, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapLegendClass'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|range|key|ref|className|style|children)$/]",
        "message": "<MapLegendClass> doesn't accept that prop. Declared props: label, color, range."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceLedger'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|source|publisher|date|claim|boundary|limitation|allowedUse|key|ref|className|style|children)$/]",
        "message": "<SourceLedger> doesn't accept that prop. Declared props: title, source, publisher, date, claim, boundary, limitation, allowedUse."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|message|note|visible|fixed|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, message, note, visible, fixed."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|showDot|key|ref|className|style|children)$/]",
        "message": "<TrustBadge> doesn't accept that prop. Declared props: status, children, showDot."
      }
    ]
  },
